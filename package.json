{
  "name": "back_todo_list",
  "version": "1.0.1",
  "description": "Este proyecto es una API backend desarrollada en Node.js que utiliza un enfoque basado en la **inyección de dependencias** con Awilix. Su principal objetivo es gestionar los datos necesarios para un frontend y manejar sesiones de usuario.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_ENV=production node index.js",
    "dev": "cross-env NODE_ENV=development nodemon index.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:unit": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "test:integration": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest tests/integration --setupFiles=./tests/integration/setup.js",
    "test:api": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest tests/api --setupFiles=./tests/api/setup.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexanderMota/back_todo_list_nodejs.git"
  },
  "author": "github.com/AlexanderMota",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AlexanderMota/back_todo_list_nodejs/issues"
  },
  "homepage": "https://github.com/AlexanderMota/back_todo_list_nodejs#readme",
  "dependencies": {
    "awilix": "12.0.4",
    "bcrypt": "5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "4.21.2",
    "file-type": "^22.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "3.12.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "dotenv": "16.4.7",
    "jest": "^30.4.2",
    "nodemon": "3.1.9",
    "supertest": "^7.3.1"
  }
}
